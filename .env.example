# ============ Claqueta: configuración ============
# Todo lo de abajo es OPCIONAL: también puedes ponerlo desde la app (Ajustes) y se guarda en la base de datos.
# Si lo defines aquí, sirve de valor por defecto para Ajustes.

# --- Servidor ---
CLAQUETA_PORT=8420
TZ=Europe/Madrid
LOG_LEVEL=INFO

# --- Acceso ---
# Si lo rellenas, la app pide contraseña (cookie firmada, 60 días). Recomendado si la expones fuera de casa.
ACCESS_PASSWORD=
# Clave para firmar la cookie de sesión. Genera una con:  openssl rand -hex 32
# (si la dejas vacía, se genera y se guarda sola en la base de datos)
SECRET_KEY=

# --- TMDB (carátulas, sinopsis, valoraciones; clave gratuita en themoviedb.org/settings/api) ---
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES
REGION=ES

# --- Jellyfin ---
# Dentro de Docker usa el nombre del contenedor si comparten red, p. ej. http://jellyfin:8096
JELLYFIN_URL=
# URL por la que TÚ abres Jellyfin en el navegador (para el botón «Reproducir»)
JELLYFIN_PUBLIC_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# --- Jellyseerr ---
# p. ej. http://jellyseerr:5055
JELLYSEERR_URL=
JELLYSEERR_PUBLIC_URL=
JELLYSEERR_API_KEY=

# --- Radarr (solo lectura: progreso de descargas) ---
# p. ej. http://radarr:7878
RADARR_URL=
RADARR_API_KEY=

# --- Letterboxd (RSS público de tu diario; el historial completo se importa desde el ZIP de exportación) ---
LETTERBOXD_USERNAME=

# --- LLM opcional y gratuito (Groq, Gemini, OpenRouter, Ollama...). Sin él, todo funciona con el motor propio. ---
# Ejemplos:
#   Groq:       https://api.groq.com/openai/v1            modelo: openai/gpt-oss-20b
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai   modelo: gemini-flash-latest
#   OpenRouter: https://openrouter.ai/api/v1              modelo: openai/gpt-oss-20b:free
#   Ollama:     http://ollama:11434/v1                    modelo: llama3.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
